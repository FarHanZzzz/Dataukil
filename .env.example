# Add-money investigation pages. No secrets are required; every value below is optional.

# SQLite file (defaults to runtime/tracefix.sqlite3). The transfer tables share the application database.
TRACEFIX_DB=runtime/tracefix.sqlite3

# Set to 0 to block money-moving correction plans (investigation, reports and non-money plans keep working).
TRACEFIX_SANDBOX_CORRECTIONS=1

# Upper bound on read-only checks per investigation (1-20).
TRACEFIX_CHECK_BUDGET=8

# Processing-clock milliseconds an outcome may stay unconfirmed before an incident opens (minimum 2000).
TRACEFIX_INCIDENT_AFTER_MS=14000

# Set to 0 to stop the background processing clock (tests drive it explicitly).
TRACEFIX_SIM_TICKER=1

# Set to 0 to disable the per-tab scoped sessions the three pages request on load.
TRACEFIX_FIXTURE_SESSIONS=1

# API chatbot at /chat. Export variables, or use the ignored runtime/chat-provider.json file.
# API keys must match their issuing provider; never put a real key in this example or frontend code.
TRACEFIX_CHAT_API_URL=https://api.aiand.com/v1
TRACEFIX_CHAT_MODEL=deepseek-ai/deepseek-v4-flash
TRACEFIX_CHAT_API_KEY=
# Seconds per model call (1-180). A deceptive message uses two calls.
TRACEFIX_CHAT_TIMEOUT=30
TRACEFIX_CHAT_RESPONSE_FORMAT=json_object

# Optional for DeepSeek Flash: disable reasoning for faster classification.
TRACEFIX_CHAT_REASONING_EFFORT=none
